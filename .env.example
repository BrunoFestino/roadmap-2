# HTTP and application behavior
ROADMAP_SERVER_PORT=8082
ROADMAP_LOG_LEVEL=INFO
ROADMAP_VAADIN_LAUNCH_BROWSER=false

# Jira connection. Base URL, token and project are required; keep the real token only in .env on the VM.
ROADMAP_JIRA_BASE_URL=https://jira.example.com
ROADMAP_JIRA_TOKEN=
ROADMAP_JIRA_PROJECT=YOUR_PROJECT
ROADMAP_JIRA_CONNECT_TIMEOUT=10s
ROADMAP_JIRA_READ_TIMEOUT=30s

# Jira custom field IDs for this Jira instance.
ROADMAP_JIRA_FIELD_EFFORT_ESTIMATE=customfield_10001
ROADMAP_JIRA_FIELD_EPIC_LINK=customfield_10002
ROADMAP_JIRA_FIELD_PARENT_MILESTONE=customfield_10003
ROADMAP_JIRA_FIELD_TARGET_START=customfield_10004
ROADMAP_JIRA_FIELD_FIRST_TIME_IN_PROGRESS=customfield_10005

# PostgreSQL. Username and password are required. Compose overrides host and port internally.
ROADMAP_DB_HOST=127.0.0.1
ROADMAP_DB_PORT=5433
ROADMAP_DB_NAME=roadmap
ROADMAP_DB_USERNAME=roadmap
ROADMAP_DB_PASSWORD=
ROADMAP_DB_POOL_SIZE=5
# Optional full JDBC override for an external database:
# ROADMAP_DB_URL=jdbc:postgresql://db.example.com:5432/roadmap

# Example roster. Format per member: Jira username|display name|role. Separate members with commas.
# Allowed roles: FRONTEND, BACKEND, MOBILE, DEVOPS, PO, SQC.
ROADMAP_TEAM_MEMBERS=jdoe|John Doe|MOBILE,asmith|Alice Smith|MOBILE,bwilson|Bob Wilson|BACKEND,mjohnson|Maria Johnson|FRONTEND,dlee|Daniel Lee|BACKEND,sbrown|Sophie Brown|BACKEND,rgarcia|Robert Garcia|BACKEND,emartin|Emma Martin|BACKEND,tanderson|Tom Anderson|DEVOPS,lthomas|Laura Thomas|PO,hclark|Henry Clark|SQC

# Jira labels accepted for each task stack. Separate aliases with commas.
ROADMAP_STACK_ALIASES_FRONTEND=front,frontend,front end,stack front,stack frontend
ROADMAP_STACK_ALIASES_BACKEND=be,backend,back end,stack be,stack backend
ROADMAP_STACK_ALIASES_MOBILE=mobile,stack mobile
ROADMAP_STACK_ALIASES_DEVOPS=devops,dev ops,stack devops
